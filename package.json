{
  "name": "lifearchive-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "safety": "node scripts/check-repo-safety.mjs",
    "safety:production": "node scripts/check-mock-excluded.mjs",
    "safety:mock": "pnpm safety:production",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "runtime:install-local": "node scripts/install-local-runtime.mjs",
    "icons:update": "node scripts/update-material-symbols.mjs",
    "icons:check": "node scripts/update-material-symbols.mjs --check",
    "test:policy": "node --test scripts/*.test.mjs",
    "test:runtime-fetch": "node --test scripts/fetch-runtime.test.mjs scripts/runtime-ci-policy.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm safety && pnpm icons:check && pnpm test:policy && pnpm test:run && pnpm build && pnpm safety:production"
  },
  "dependencies": {
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/markdown": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "lexical": "0.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
